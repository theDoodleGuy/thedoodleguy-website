---
layout: base.njk
isPost: true
---
<article class="article">
  <a class="hand back" href="/blog/">← back to all posts</a>
  <div class="post-meta mono">
    <span class="tag tag-{{ pillar | replace(' ', '') | lower }}">{{ pillar }}</span>
    <span><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time> · {{ readTime }} read</span>
  </div>
  <h1 class="display">{{ title }}</h1>
  <svg viewBox="0 0 180 14" width="220" aria-hidden="true" class="draw-in">
    <path d="M3 9 C 20 2, 35 13, 52 7 S 85 2, 102 8 S 140 13, 177 5" fill="none" stroke="var(--red)" stroke-width="3.5" stroke-linecap="round" pathLength="1"/>
  </svg>

  <div class="article-body">
    {{ content | safe }}
  </div>

  <div class="article-end">
    <p class="hand signoff">~ theDoodleGuy ✏️</p>
    {% set shareUrl = (site.url + page.url) | urlencode %}
    {% set shareText = title | urlencode %}
    <section class="share" aria-labelledby="share-label">
      <span class="share-tape" aria-hidden="true"></span>
      <div class="share-head">
        <h2 id="share-label" class="hand share-label">know someone who needs this? send it their way</h2>
        <svg class="share-arrow" viewBox="0 0 60 44" aria-hidden="true">
          <path d="M6 6 C 22 4, 40 12, 44 34" fill="none" stroke="var(--red)" stroke-width="3" stroke-linecap="round"/>
          <path d="M35 28 L 44 36 L 51 25" fill="none" stroke="var(--red)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="share-main">
        <a class="share-big share-linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareUrl }}" target="_blank" rel="noopener">
          <svg class="share-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          <span>LinkedIn</span>
        </a>
        <a class="share-big share-facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl }}" target="_blank" rel="noopener">
          <svg class="share-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647z"/></svg>
          <span>Facebook</span>
        </a>
      </div>
      <ul class="share-more" role="list">
        <li><a class="share-dot share-x" href="https://x.com/intent/post?text={{ shareText }}&url={{ shareUrl }}" target="_blank" rel="noopener" aria-label="Share on X">
          <svg class="share-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg></a></li>
        <li><a class="share-dot share-bluesky" href="https://bsky.app/intent/compose?text={{ shareText }}%20{{ shareUrl }}" target="_blank" rel="noopener" aria-label="Share on Bluesky">
          <svg class="share-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/></svg></a></li>
        <li><a class="share-dot share-whatsapp" href="https://wa.me/?text={{ shareText }}%20{{ shareUrl }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
          <svg class="share-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg></a></li>
        <li><a class="share-dot share-reddit" href="https://www.reddit.com/submit?url={{ shareUrl }}&title={{ shareText }}" target="_blank" rel="noopener" aria-label="Share on Reddit">
          <svg class="share-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286C.775 23.225 1.097 24 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0Zm4.388 3.199c1.104 0 1.999.895 1.999 1.999 0 1.105-.895 2-1.999 2-.946 0-1.739-.657-1.947-1.539v.002c-1.147.162-2.032 1.15-2.032 2.341v.007c1.776.067 3.4.567 4.686 1.363.473-.363 1.064-.58 1.707-.58 1.547 0 2.802 1.254 2.802 2.802 0 1.117-.655 2.081-1.601 2.531-.088 3.256-3.637 5.876-7.997 5.876-4.361 0-7.905-2.617-7.998-5.87-.954-.447-1.614-1.415-1.614-2.538 0-1.548 1.255-2.802 2.803-2.802.645 0 1.239.218 1.712.585 1.275-.79 2.881-1.291 4.64-1.365v-.01c0-1.663 1.263-3.034 2.88-3.207.188-.911.993-1.595 1.959-1.595Zm-8.085 8.376c-.784 0-1.459.78-1.506 1.797-.047 1.016.64 1.429 1.426 1.429.786 0 1.371-.369 1.418-1.385.047-1.017-.553-1.841-1.338-1.841Zm7.406 0c-.786 0-1.385.824-1.338 1.841.047 1.017.634 1.385 1.418 1.385.785 0 1.473-.413 1.426-1.429-.046-1.017-.721-1.797-1.506-1.797Zm-3.703 4.013c-.974 0-1.907.048-2.77.135-.147.015-.241.168-.183.305.483 1.154 1.622 1.964 2.953 1.964 1.33 0 2.47-.81 2.953-1.964.057-.137-.037-.29-.184-.305-.863-.087-1.795-.135-2.769-.135Z"/></svg></a></li>
        <li><a class="share-dot share-email" href="mailto:?subject={{ shareText }}&body={{ shareUrl }}" aria-label="Share by email">
          <svg class="share-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M3.5 6.5 L12 13 L20.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
        <li><button type="button" class="share-pill share-copy" data-url="{{ site.url }}{{ page.url }}">
          <svg class="share-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L11.6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4l1.6-1.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          <span class="share-copy-text" aria-live="polite">Copy link</span></button></li>
        <li class="share-native-item" hidden><button type="button" class="share-pill share-native" data-title="{{ title }}" data-url="{{ site.url }}{{ page.url }}">
          <svg class="share-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3.5M7.5 8 12 3.5 16.5 8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 12v6.5A2 2 0 0 0 7 20.5h10a2 2 0 0 0 2-2V12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          <span>Share…</span></button></li>
      </ul>
    </section>
  </div>
  <script>
    (function () {
      var native = document.querySelector('.share-native');
      if (native && navigator.share) {
        native.closest('li').hidden = false;
        native.addEventListener('click', function () {
          navigator.share({ title: native.dataset.title, url: native.dataset.url }).catch(function () {});
        });
      }
      // On phones the LinkedIn web share URL opens in the browser, not the app.
      // Use the native share sheet there so LinkedIn's app can be picked; desktop keeps the web link.
      var linkedin = document.querySelector('.share-linkedin');
      var isTouch = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
      if (linkedin && navigator.share && isTouch) {
        linkedin.addEventListener('click', function (e) {
          e.preventDefault();
          navigator.share({ title: native ? native.dataset.title : document.title, url: native ? native.dataset.url : location.href })
            .catch(function (err) { if (err && err.name !== 'AbortError') window.open(linkedin.href, '_blank', 'noopener'); });
        });
      }
      var copy = document.querySelector('.share-copy');
      if (copy) copy.addEventListener('click', function () {
        var label = copy.querySelector('.share-copy-text');
        var done = function () {
          label.textContent = 'Copied ✓'; copy.classList.add('is-copied');
          setTimeout(function () { label.textContent = 'Copy link'; copy.classList.remove('is-copied'); }, 2000);
        };
        if (navigator.clipboard) navigator.clipboard.writeText(copy.dataset.url).then(done, function () { prompt('Copy this link:', copy.dataset.url); });
        else prompt('Copy this link:', copy.dataset.url);
      });
    })();
  </script>
</article>

{% include "newsletter.njk" %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ page.date | isoDate }}",
  "author": { "@type": "Person", "name": "{{ site.author }}", "url": "{{ site.url }}" },
  "publisher": { "@type": "Organization", "name": "{{ site.name }}", "url": "{{ site.url }}" },
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>
