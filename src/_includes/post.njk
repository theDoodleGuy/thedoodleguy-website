---
layout: base.njk
isPost: true
---
<article class="article">
  <a class="hand back" href="/blog/">← back to all posts</a>
  <div class="post-meta mono">
    <span class="tag tag-{{ pillar | replace(' ', '') | lower }}">{{ pillar }}</span>
    <span><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time> · {{ readTime }} read</span>
  </div>
  <h1 class="display">{{ title }}</h1>
  <svg viewBox="0 0 180 14" width="220" aria-hidden="true" class="draw-in">
    <path d="M3 9 C 20 2, 35 13, 52 7 S 85 2, 102 8 S 140 13, 177 5" fill="none" stroke="var(--red)" stroke-width="3.5" stroke-linecap="round" pathLength="1"/>
  </svg>

  <div class="article-body">
    {{ content | safe }}
  </div>

  <div class="article-end">
    <p class="hand signoff">~ theDoodleGuy ✏️</p>
    {% set shareUrl = (site.url + page.url) | urlencode %}
    {% set shareText = title | urlencode %}
    <div class="share" aria-label="Share this post">
      <p class="hand share-label">liked it? pass it on →</p>
      <div class="share-buttons">
        <button type="button" class="share-btn share-native" hidden data-title="{{ title }}" data-url="{{ site.url }}{{ page.url }}">Share…</button>
        <a class="share-btn" href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareUrl }}" target="_blank" rel="noopener">LinkedIn</a>
        <a class="share-btn" href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl }}" target="_blank" rel="noopener">Facebook</a>
        <a class="share-btn" href="https://x.com/intent/post?text={{ shareText }}&url={{ shareUrl }}" target="_blank" rel="noopener">X</a>
        <a class="share-btn" href="https://bsky.app/intent/compose?text={{ shareText }}%20{{ shareUrl }}" target="_blank" rel="noopener">Bluesky</a>
        <a class="share-btn" href="https://wa.me/?text={{ shareText }}%20{{ shareUrl }}" target="_blank" rel="noopener">WhatsApp</a>
        <a class="share-btn" href="https://www.reddit.com/submit?url={{ shareUrl }}&title={{ shareText }}" target="_blank" rel="noopener">Reddit</a>
        <a class="share-btn" href="mailto:?subject={{ shareText }}&body={{ shareUrl }}">Email</a>
        <button type="button" class="share-btn share-copy" data-url="{{ site.url }}{{ page.url }}">Copy link</button>
      </div>
    </div>
  </div>
  <script>
    (function () {
      var native = document.querySelector('.share-native');
      if (native && navigator.share) {
        native.hidden = false;
        native.addEventListener('click', function () {
          navigator.share({ title: native.dataset.title, url: native.dataset.url }).catch(function () {});
        });
      }
      var copy = document.querySelector('.share-copy');
      if (copy) copy.addEventListener('click', function () {
        var done = function () { copy.textContent = 'Copied ✓'; setTimeout(function () { copy.textContent = 'Copy link'; }, 2000); };
        if (navigator.clipboard) navigator.clipboard.writeText(copy.dataset.url).then(done, function () { prompt('Copy this link:', copy.dataset.url); });
        else prompt('Copy this link:', copy.dataset.url);
      });
    })();
  </script>
</article>

{% include "newsletter.njk" %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ page.date | isoDate }}",
  "author": { "@type": "Person", "name": "{{ site.author }}", "url": "{{ site.url }}" },
  "publisher": { "@type": "Organization", "name": "{{ site.name }}", "url": "{{ site.url }}" },
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>
